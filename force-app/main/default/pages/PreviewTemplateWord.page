                        function getContentBetween(htmlContent, startTag = '<body>', endTag = '</body>') {
        if (!htmlContent || typeof htmlContent !== 'string') {
            console.warn('Invalid htmlContent:', htmlContent);
            return '<p>No content available</p>';
        }

        try {
            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlContent, 'text/html');
            // Find the innermost body content (e.g., inside htmlContentToWord)
            const innerContentDiv = doc.querySelector('#htmlContentToWord');
            if (innerContentDiv) {
                console.log('Found htmlContentToWord, extracting inner body');
                const innerDoc = parser.parseFromString(innerContentDiv.innerHTML, 'text/html');
                const innerBody = innerDoc.querySelector('body');
                if (innerBody) {
                    return innerBody.innerHTML.trim();
                }
            }
            // Fallback to first body
            const body = doc.querySelector('body');
            if (body) {
                return body.innerHTML.trim();
            }
            console.warn('No body tag found, returning cleaned htmlContent');
            return htmlContent.replace(/<script[\s\S]*?\/script>|<style[\s\S]*?\/style>/gi, '').trim();
        } catch (error) {
            console.warn('DOM parsing failed:', error.message);
            // Fallback to string-based extraction
            const startIndex = htmlContent.indexOf(startTag) + startTag.length;
            const endIndex = htmlContent.lastIndexOf(endTag); // Use lastIndexOf to get innermost body
            if (startIndex === -1 || endIndex === -1 || startIndex >= endIndex) {
                console.warn('Body tags not found, returning cleaned htmlContent');
                return htmlContent.replace(/<script[\s\S]*?\/script>|<style[\s\S]*?\/style>/gi, '').trim();
            }
            return htmlContent.substring(startIndex, endIndex).trim();
        }
    }
                </script>

                <div id="htmlContentToWord" style="visibility:visible;">
                    <apex:outputtext value="{!output}" escape="false" />
                </div>
                <div id="previewContent">
                    <button onclick="ExportToDoc('htmlContentToWord', '{!worddocName}','Yes')"  id="download-area" style="margin-top: 0px; padding: 10px; background: #354673 !important; color: white; border: none; cursor: pointer;">
                        <i class="fas fa-download"></i> Download Word
                    </button>
                    <iframe id="pdfIframe" src="{!('/apex/JunoDoc__JunodocPDFMobile?id='+recordId+'&DocTemplateId='+DocId)}#toolbar=0" style="width:100%; height:445px;"></iframe>
                </div>
                <apex:outputtext value="{!loadstring}" escape="false" />

                <!-- Download Button -->
                
          
    </div>
</apex:page>