<apex:page id="pageId" action="{!methodtwo}" Controller="PreviewTemplatePDF_AC" applyBodyTag="false" showHeader="false" sidebar="false" applyHtmlTag="false"  standardStylesheets="true" doctype="HTML-5.0">
    <div id="word-page-content">
       
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
