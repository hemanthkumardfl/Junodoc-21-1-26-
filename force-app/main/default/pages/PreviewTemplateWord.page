                       function splitHtmlIntoSections(htmlContent) {
                            const sections = [];
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(htmlContent, 'text/html');
                    
                            // Find all divs with the specified classes
                            const landscapeDivs = doc.querySelectorAll('div.landscape_A4_page');//landscape_A4_page2
                            const portraitDivs = doc.querySelectorAll('div.portrait_A4_page');
                            //const landscapeDivs2 = doc.querySelectorAll('div.landscape_A4_page2');
                            console.log('landscapeDivs::: ' + landscapeDivs)
                    
                            // Process landscape sections
                            landscapeDivs.forEach(div => {
                                sections.push({
                                    type: 'landscape', // Optional: Just for tracking, not used for formatting
                                    content: div.innerHTML,
                                    orientation: 'landscape'
                                });
                                console.log('Outer HTML:', div.outerHTML);
                            });
                    
                            // Process portrait sections
                            portraitDivs.forEach(div => {
                                sections.push({
                                    type: 'portrait', // Optional: Just  for tracking, not used for formatting
                                    content: div.innerHTML,
                                    orientation: 'portrait'
                                });
                            });
                    
                            /*landscapeDivs2.forEach(div => {
                                sections.push({
                                    type: 'landscape', // Optional: Just for tracking, not used for formatting
                                    content: div.innerHTML,
                                    orientation: 'landscape'
                                });
                                console.log('Outer HTML:', div.outerHTML);
                            });*/
                    
                            // Fallback: If no sections found, treat entire content as a single section
                            if (sections.length === 0) {
                                sections.push({
                                    type: 'default',
                                    content: htmlContent
                                });
                            }
                    
                            return sections;
                        }
                    
