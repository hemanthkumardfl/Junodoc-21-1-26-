                <script>
                    function loadwordScrip1t() {
                        console.log('Loading word script...' + document.getElementById('htmlContentToWord').innerHTML);
				
                        // Hide and remove specific elements based on data attributes
                        let hideDivs = document.querySelectorAll('[data-renderdiv="hideDiv"]');
                        hideDivs.forEach(div => div.parentElement.offsetParent.offsetParent.parentElement.parentElement.remove());

                        let removeElements = document.querySelectorAll('[data-renderele="removeItem"]');
                        removeElements.forEach(el => el.remove());

                        let styleEle = document.querySelectorAll('[data-forstyle="checkbox"]');
                        styleEle.forEach(el => {
                            el.style.width = "12px";
                            el.style.height = "12px";
                            el.style.margin = "5px";
                        });
						
                        ExportToDoc('htmlContentToWord', '{!worddocName}','No');

                        // Ensure the content is fully rendered before capturing it
                        setTimeout(function() {
                            console.log('Starting export to PDF...');
                            // exportToPdfAndDisplay('htmlContentToWord', '{!worddocName}');
                            displayPdfDocument('');
                        }, 100); // Adjust the delay as needed
                    }

                    function ExportToDoc(element, filename = '',isDownload) {
                            // Get the target element's HTML content
                        var targetElement = document.getElementById(element);
                             console.log('targetElement.innerHTML' + targetElement.innerHTML)
                            // Create a temporary container to manipulate the HTML
                            var tempContainer = document.createElement('div');
                            tempContainer.innerHTML = targetElement.innerHTML;
                        
                            // Remove all elements with the class 'table-setting-box'
                            var elementsToRemove = tempContainer.querySelectorAll('.table-setting-box');
                            elementsToRemove.forEach(function(el) {
                                el.parentNode.removeChild(el);
                            });
                            tempContainer.innerHTML = tempContainer.innerHTML.replace('Page <span class="pagenumber"></span> of <span class="pagecount"></span>','Page <span style="mso-field-code: PAGE "></span> of <span style="mso-field-code: NUMPAGES "></span>');
                            tempContainer.innerHTML = tempContainer.innerHTML.replace('Page <span class="pagenumber"></span> of <span class="pagecount"></span>','Page <span style="mso-field-code: PAGE "></span> of <span style="mso-field-code: NUMPAGES "></span>');
                            tempContainer.innerHTML = tempContainer.innerHTML.replace('Page <span class="pagenumber"></span> of <span class="pagecount"></span>','Page <span style="mso-field-code: PAGE "></span> of <span style="mso-field-code: NUMPAGES "></span>');
                            tempContainer.innerHTML = tempContainer.innerHTML.replace('Page <span class="pagenumber"></span> of <span class="pagecount"></span>','Page <span style="mso-field-code: PAGE "></span> of <span style="mso-field-code: NUMPAGES "></span>');
                        var header = "<!DOCTYPE html><html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>";
                        header += '<meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1"/> <meta http-equiv="X-UA-Compatible" content="IE=edge"/><meta name="viewport" content="width=device-width, initial-scale=1"/> ';
                        header += '<title></title> <style>v\\:* {behavior: url(#default#VML);} o\\:* { behavior: url(#default#VML);} w\\:* {behavior: url(#default#VML);} .shape { behavior: url(#default#VML);} </style>';
                        header += ' <style> @page main-section {size: 8.43in 12in;  margin: .0cm .0cm .0cm .0cm;mso-header-margin: .0in;mso-footer-margin: .0in;mso-paper-source: 0;height:12in';
                        header += 'mso-header: h1;mso-footer: f1;}div.main-section {page: main-section;} .Tableorder table,tr, td{font-family:sans-serif} div{height:auto} td{height:auto} p{height:auto}';
                        header += ' img{width: 15px !important;height: 15px !important; }p.MsoFooter,li.MsoFooter,div.MsoFooter {margin: 0in;margin-bottom: .0001pt;mso-pagination: widow-orphan;tab-stops: center 0in right 0in;} div[data-renderdiv="showDiv"]{display: block; }div[data-renderdiv="hideDiv"]{display: none; } .pagenumber:before {content: counter(page);}.pagecount:before {content: counter(pages);}</style><body>';
                         
                            var footer = "</body></html>";
                            console.log('*****'+tempContainer.innerHTML);
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(tempContainer.innerHTML, 'text/html');
                            
                            // 2. REMOVE UNNECESSARY DATA
                            // Remove all Salesforce UI resizer handles and setting buttons
                            const junkSelectors = '.ui-resizable-handle, .table-setting-box, .ui-icon, script';
                            doc.querySelectorAll(junkSelectors).forEach(el => el.remove());
                            
                            // 1. Remove truly empty divs (no text, no children)
                            doc.querySelectorAll('div').forEach(div => {
                                // Check if the div has no visible text and no child elements (like <img> or <table>)
                                // We trim() to ensure we don't count whitespace as content
                                const hasContent = div.textContent.trim().length > 0 || div.children.length > 0;
                                
                                // EXCEPTION: Don't remove divs used for page breaks
                                const isPageBreak = div.style.pageBreakAfter === 'always' || div.classList.contains('page-break');
                            
                                if (!hasContent && !isPageBreak) {
                            //  div.remove();
                                }
                            });
                            
                            
                            
                            // 2. OPTIONAL: Remove empty paragraphs <p></p> which often cause extra spacing
                            doc.querySelectorAll('p').forEach(p => {
                                if (p.textContent.trim().length === 0 && p.children.length === 0) {
                                    p.remove();
                                }
                            });

                            // 4. GET THE CLEANED HTML
                            var cleanedContent =  doc.getElementById('sectionMain').innerHTML;
                            var headersMain = '';
                            if(doc.getElementById('h1') != null){
                            	headersMain = doc.getElementById('h1').innerHTML;
                            }
                            else if(document.getElementById('h1') != null){
                            	headersMain = document.getElementById('h1').innerHTML;
                            }
                            var footersMain = '';
                            if(doc.getElementById('f1') != null){
                            	footersMain = doc.getElementById('f1').innerHTML;
                            }
                            else if(document.getElementById('f1') != null){
                            	footersMain = document.getElementById('f1').innerHTML;
                            }
								// 4. Remove the ENTIRE source table from the main document body's view
                                const hfTable = doc.getElementById('hrdftrtbl');
                                if (hfTable) {
                                    hfTable.remove(); 
                                }
                            // var htmls = header + tempContainer.innerHTML + footer;
                           
                            //   var html = '<!DOCTYPE html>'+ tempContainer.innerHTML;
                            var html = `
                            <!DOCTYPE html>
                            <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org'>
                            <head>
                            <meta charset="utf-8"/>
                            <style>
                            /* Word Specific Reset */
                            p, div, td { margin: 0px !important;margin-bottom:0px !important; line-height: normal; mso-margin-top-alt: 0pt; /* Word-specific fix */
                            mso-margin-bottom-alt: 0pt; /* Word-specific fix */ }
                                         table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
                                         
                                         @page Section1 {
                                         size: 8.5in 11.0in; 
                                         margin: 0in;
                                         mso-header: h1;
                                         mso-footer: f1;
                                         mso-header-margin: 0in;
                                         mso-footer-margin: 0in;
                                         }
                                         div.Section1 { page: Section1; }
                                         
                                         /* This hides the source elements so they don't show in the body */
                                         #hrdftrtbl { display: none !important; position: absolute; top: -9999px; }
                                         div#h1 { mso-element: header; }
                                         div#f1 { mso-element: footer; }
                                         </style>
                                         </head>
                                         <body>
                                         <!-- 1. THE MAIN CONTENT -->
                                         <div class="Section1">
                                         ${cleanedContent} 
                                         </div>
                                         
                                         <!-- 2. THE HIDDEN DEFINITIONS (Outside the Section1 Div) -->
                            <table id="hrdftrtbl">
                                <tr>
                                <td>
                                <div id="h1">
                                    ${headersMain} 
                        </div>
                        </td>
                        <td>
                            <div id="f1">
                                ${footersMain} 
                        </div>
                        
                        </td>
                        </tr>
                        </table>
                        </body>
                        </html>`;
                 
                  var parser = new DOMParser();
                            var docs = parser.parseFromString(html, 'text/html');
					
                        
                        const elements = docs.querySelectorAll('p, div');

                        elements.forEach(el => {
                            // Force margins and padding to 0 points (0in also works)
                            el.style.margin = '0px !important';
                            el.style.marginBottom = '0px !important';
                          
                            // Prevent Word's default 8pt spacing After paragraphs
                            el.style.msoMarginTopAlt = '0px !important';
                            el.style.msoMarginBottomAlt = '0px !important';
                            
                            // Prevents extra vertical space caused by default 1.08 line height
                            el.style.lineHeight = 'normal'; 
                            
                            // Ensure standard display properties
                            if (el.tagName !== 'TABLE' && el.tagName !== 'TR' && el.tagName !== 'TD') {
                            //  el.style.display = 'block';
                             	
                            }
                            
                            // Remove floats that interfere with page breaks
                            // el.style.float = 'none';
                        });
                            
                        const hfTables = docs.getElementById('hrdftrtbl');
                                if (hfTables) {
                                    hfTables.style.display = 'none'; 
                                    hfTables.style.margin = '0in 0in 0in 9in';
                                    hfTables.style.height = '0px';
                            		hfTables.style.float = 'right';
                                }

						console.log('cleanedContent **'+ cleanedContent);
                        var finalHtmlString = docs.documentElement.outerHTML; // Get the *entire* modified HTML
                            // var blob = new Blob(['\ufeff', html], { type: 'application/msword' });
                         var blob = htmlDocx.asBlob(finalHtmlString, {orientation: 'portrait'});
                        //   saveAs(blob, 'test.docx');
						
                        var reader = new FileReader();
                        reader.readAsDataURL(blob);

                        reader.onloadend = function() {
                            var base64data = reader.result.split(',')[1];
                            console.log('Base64 string:', base64data);

                            var datas = JSON.stringify({ message: base64data });
                            window.parent.postMessage(datas, '*');
                        };

                        //  var url = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(html);
                        filename = filename ? filename + '.docx' : 'document.docx';
                        if(isDownload == 'Yes'){
                            /*  var downloadLink = document.createElement("a");
                            document.body.appendChild(downloadLink);
    
                            if (navigator.msSaveOrOpenBlob) {
                                navigator.msSaveOrOpenBlob(blob, filename);
                            } else {
                                downloadLink.href = url;
                                downloadLink.download = filename;
                                downloadLink.click(html);
                            }*/
                            
                                var link = document.createElement('a');
                              link.href = URL.createObjectURL(blob);
                              link.download = filename;
                            
                              var downloadArea = document.getElementById('download-area');
                              downloadArea.appendChild(link);
                            saveAs(blob, filename);
                         }
                        document.getElementById(element).style.display='none';
                        if(document.getElementById('h1') != null)
                        document.getElementById('h1').style.display='none';
                        if(document.getElementById('f1') != null)
                        document.getElementById('f1').style.display='none';
                        // document.body.removeChild(link);
                    }

                    function exportToPdfAndDisplay(elementId, filename = '') {
                        var element = document.getElementById(elementId);
                        console.log('Capturing element:', element);

                        html2canvas(element).then(function(canvas) {
                            var imgData = canvas.toDataURL('image/png');
                            console.log('Canvas image data:', imgData);

                            // Here, convert the HTML content to a format compatible with pdfMake
                            var docDefinition = {
                                content: [
                                    { text: 'Your Title', style: 'header' },
                                    {
                                        text: element.innerHTML,
                                        width: canvas.width * 0.75, // Adjust as needed
                                        height: canvas.height * 0.75 // Adjust as needed
                                    }
                                ],
                                footer: {
                                    columns: [
                                        'Left part of footer',
                                        { text: 'Right part of footer', alignment: 'right' }
                                    ]
                                },
                                header: {
                                    columns: [
                                        'Left part of header',
                                        { text: 'Right part of header', alignment: 'right' }
                                    ]
                                },
                                pageMargins: [40, 60, 40, 60], // [left, top, right, bottom] margins
                                styles: {
                                    header: {
                                        fontSize: 18,
                                        bold: true,
                                        margin: [0, 0, 0, 10]
                                    }
                                }
                            };

                            pdfMake.createPdf(docDefinition).getBlob(function(blob) {
                                var url = URL.createObjectURL(blob);
                                displayPdfDocument(url);
                            });

                        }).catch(function(error) {
                            console.error('Error capturing the canvas:', error);
                        });
                    }

                    function displayPdfDocument(url) {
                        console.log('Displaying PDF document at URL:', url);
                        var iframe = document.getElementById('pdfIframe');
                        // iframe.src = url;
                        iframe.style.visibility = 'visible';
                    }
                
                	
                </script>
                <div id="htmlContentToWord" style="visibility:visible;">
                    <apex:outputtext value="{!output}" escape="false" />
                </div>
                <div id="previewContent">
                    <button onclick="ExportToDoc('htmlContentToWord', '{!worddocName}','Yes')"  id="download-area" style="margin-top: 0px; padding: 10px; background: #354673 !important; color: white; border: none; cursor: pointer;">
                        <i class="fas fa-download"></i> Download Word
                    </button>
                    <iframe id="pdfIframe" src="{!('/apex/JunoDoc__JunodocPDFMobile?id='+recordId+'&DocTemplateId='+DocId)}#toolbar=0" style="width:100%; height:445px;"></iframe>
                </div>
                <apex:outputtext value="{!loadstring}" escape="false" />

                <!-- Download Button -->
                
          
    </div>
</apex:page>