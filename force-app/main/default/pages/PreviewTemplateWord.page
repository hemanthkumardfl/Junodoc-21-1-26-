function pxToTwip(px) {
    return Math.round(parseFloat(px || 0) * 15);
}

function hasVisibleBorder(style) {
    if (!style) return false;

    return (
        (style.border && !style.border.includes('0') && !style.border.includes('none')) ||
        (style.borderTop && !style.borderTop.includes('0') && !style.borderTop.includes('none')) ||
        (style.borderBottom && !style.borderBottom.includes('0') && !style.borderBottom.includes('none')) ||
        (style.borderLeft && !style.borderLeft.includes('0') && !style.borderLeft.includes('none')) ||
        (style.borderRight && !style.borderRight.includes('0') && !style.borderRight.includes('none'))
    );
}

function parseInlineContent(node) {
    const runs = [];

    node.childNodes.forEach(child => {
        if (child.nodeType === Node.TEXT_NODE && child.textContent.trim()) {
            runs.push(new window.docx.TextRun({
                text: child.textContent.replace(/\s+/g, ' ')
            }));
        } 
        else if (child.nodeType === Node.ELEMENT_NODE) {
            const tag = child.tagName.toUpperCase();

            if (tag === 'BR') {
                runs.push(new window.docx.TextRun({ break: 1 }));
            } 
            else if (tag === 'B' || tag === 'STRONG') {
                runs.push(new window.docx.TextRun({
                    text: child.textContent,
                    bold: true
                }));
            } 
            else {
                runs.push(...parseInlineContent(child));
            }
        }
    });

    return runs;
}

